if da_best_rows:
    df_da_best = pd.DataFrame(da_best_rows, columns=[
        "pdf","method","start","end","page_guess_start","page_guess_end","confidence","text"
    ])
    # sort for readability
    df_da_best = df_da_best.sort_values(["pdf","confidence"], ascending=[True, False])
else:
    df_da_best = pd.DataFrame(columns=["pdf","method","start","end","page_guess_start","page_guess_end","confidence","text"])
