TRAILING = ").,;:!?]»”'\""
DASHES   = dict.fromkeys(map(ord, "\u2010\u2011\u2012\u2013\u2014\u2212"), "-")
PUNCT_MAP = {
    ord("\u2024"): ".", ord("\u2027"): ".", ord("\u2219"): ".", ord("\u22C5"): ".", ord("\u30FB"): ".",
    ord("\uFF0E"): ".", ord("\u2044"): "/", ord("\u2215"): "/", ord("\uFF0F"): "/", ord("\uFF1A"): ":",
}
INVISIBLE_SPACE_CODES = [
    "\u200b","\u200c","\u200d","\ufeff","\u2060","\u00ad","\u2000","\u2001","\u2002","\u2003","\u2004",
    "\u2005","\u2006","\u2007","\u2008","\u2009","\u200a","\u202f","\u205f","\u3000"
]

# ===== tails & artifacts to trim from DOIs =====
STOPWORD_TAILS = {
    "and","or","which","that","through","containing","contain","includes","include","suggest",
    "methods","supinfo","supportinginformation","supporting","supplementary","supplement",
    "deposited","deposition","accessed","retrieved","downloaded","freshwater","planetary",
    "relevance","local-and","evidence","piovia-scott","knapp","jagger","krawemer","mate","s",
    "fieldwork","subsidiaries","subsidies","food","effect","change","which","this","with",
}
PUBLISHER_ARTIFACT_PATHS = (
    "/-/", "/supplemental", "/dcsupplemental", "/supplementary", "/supmat", "/supinfo"
)
PUBLISHER_ARTIFACT_HASHES = ("#supplementary-materials", "#supplement", "#suppl", "#supporting")

# =================== cleaning ===================
def clean(t: str) -> str:
    if not t:
        return ""
    t = unicodedata.normalize("NFKC", t)
    for ch in INVISIBLE_SPACE_CODES:
        t = t.replace(ch, "")
    t = t.replace("\u00a0", " ").translate(DASHES).translate(PUNCT_MAP)
    t = re.sub(r"-\s*\n\s*", "", t)
    t = re.sub(r"[ \t]*\n[ \t]*", " ", t)
    t = re.sub(r"\s*([./:_-])\s*", r"\1", t)
    t = re.sub(r"\s{2,}", " ", t).strip()
    return t

def norm_doi(s: str) -> str:
    s = re.sub(r"^\s*doi:\s*", "", s, flags=re.I).strip()
    if s.lower().startswith(("http://doi.org/","https://doi.org/","http://dx.doi.org/","https://dx.doi.org/")):
        s = "https://doi.org/" + s.split("doi.org/", 1)[1]
    elif s.lower().startswith("10."):
        s = "https://doi.org/" + s
    return s.lower().rstrip(TRAILING)

def doi_url_to_bare(s: str) -> str:
    s = s.strip().lower()
    if s.startswith(("https://doi.org/","http://doi.org/","https://dx.doi.org/","http://dx.doi.org/")):
        return s.split("doi.org/", 1)[1]
    return s

def to_article_id(doi_or_url: str) -> str:
    bare = doi_url_to_bare(doi_or_url)
    return bare.replace("/", "_", 1)

# =================== DOI regexes ===================
_DOI_CORE = r"[-._;()/:A-Z0-9]+"
STRICT_DOI_CORE = re.compile(rf"^https?://(?:dx\.)?doi\.org/(10\.\d{{4,9}}/[^,()\[\]\s<>&?\"']+)", re.I)
BARE_DOI_CORE   = re.compile(rf"^(10\.\d{{4,9}}/[^,()\[\]\s<>&?\"']+)", re.I)
DOI_QS_RE       = re.compile(rf"[?&]doi=(10\.\d{{4,9}}/{_DOI_CORE})", re.I)
DOI_URL_RE      = re.compile(rf"https?://(?:dx\.)?doi\.org/10\.\d{{4,9}}/[^,()\[\]\s<>&?\"']+", re.I)
DOI_BARE_RE     = re.compile(rf"(?<!doi\.org/)10\.\d{{4,9}}/[^,()\[\]\s<>&?\"']+", re.I)
DOI_COLON_RE    = re.compile(rf"\bdoi:\s*(10\.\d{{4,9}}/[^,()\[\]\s<>&?\"']+)", re.I)
DOI_FUZZY_RE    = re.compile(r"10\.\d{4,9}/[^\s<>\]\)\}\"']+", re.I)
SHORT_DOI_RE    = re.compile(r"https?://(?:dx\.)?doi\.org/10/[A-Za-z0-9]+", re.I)

def _trim_runon_suffix(bare: str) -> str:
    if not re.match(r"^10\.\d{4,9}/", bare, re.I):
        return bare
    # remove publisher hash fragments
    for h in PUBLISHER_ARTIFACT_HASHES:
        if h in bare:
            bare = bare.split(h, 1)[0]
    # remove known artifact paths following a valid DOI core
    for p in PUBLISHER_ARTIFACT_PATHS:
        if p in bare:
            bare = bare.split(p, 1)[0]
    # drop “english word” tails like .and .which .methods (iteratively)
    while True:
        m = re.search(r"\.([A-Za-z][A-Za-z\-]{1,50})$", bare)
        if not m: break
        if m.group(1).lower() in STOPWORD_TAILS:
            bare = bare[: - (len(m.group(1)) + 1)]
            continue
        break
    # long alpha-only tails (already handled in your masterclass, keep as final guard)
    parts = bare.split(".")
    if len(parts) > 2:
        while parts and re.fullmatch(r"[A-Za-z]{12,}", parts[-1] or ""):
            parts.pop()
        bare = ".".join(parts)
    return bare.rstrip(".;:,-_/")

def clamp_doi(s: str):
    s = re.sub(r"^\s*doi:\s*", "", s, flags=re.I)
    s = clean(s)
    m = STRICT_DOI_CORE.match(s) or BARE_DOI_CORE.match(s)
    core = m.group(1) if m else (DOI_FUZZY_RE.search(s).group(0) if DOI_FUZZY_RE.search(s) else None)
    if not core:
        return None
    core = _trim_runon_suffix(core)
    return ("https://doi.org/" + core).lower()

def canonize(dois):
    out = set()
    for x in dois:
        c = clamp_doi(norm_doi(x))
        if c:
            out.add(c)
    return sorted(out)

