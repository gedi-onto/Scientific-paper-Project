# =================== HELPERS ===================
TRAILING = ").,;:!?]»”'\""
DASHES = dict.fromkeys(map(ord, "\u2010\u2011\u2012\u2013\u2014\u2212"), "-")  # hyphen, NB-hyphen, fig dash, en, em, minus

def clean(t: str) -> str:
    if not t: return ""
    t = t.replace("\u00ad", "").replace("\u200b", "")     # soft/zero-width hyphen
    t = t.translate(DASHES)                               # normalize dashes
    t = re.sub(r"-\s*\n\s*", "", t)                       # join hyphen-breaks
    t = re.sub(r"[ \t]*\n[ \t]*", " ", t)                 # collapse newlines
    return re.sub(r"\s{2,}", " ", t).strip()

def norm_doi(s: str) -> str:
    s = re.sub(r"^\s*doi:\s*", "", s, flags=re.I).strip()
    if s.lower().startswith(("http://doi.org/","https://doi.org/","http://dx.doi.org/","https://dx.doi.org/")):
        s = "https://doi.org/" + s.split("doi.org/", 1)[1]
    elif s.lower().startswith("10."):
        s = "https://doi.org/" + s
    return s.lower().rstrip(TRAILING)

def doi_url_to_bare(s: str) -> str:
    s = s.strip().lower()
    if s.startswith(("https://doi.org/","http://doi.org/","https://dx.doi.org/","http://dx.doi.org/")):
        return s.split("doi.org/", 1)[1]
    return s

def to_article_id(doi_or_url: str) -> str:
    bare = doi_url_to_bare(doi_or_url)
    return bare.replace("/", "_", 1)

# clamp DOI to safe core
STRICT_DOI_CORE = re.compile(r"^https?://(?:dx\.)?doi\.org/(10\.\d{4,9}/[^()\[\]\s<>&?\"']+)", re.I)
BARE_DOI_CORE   = re.compile(r"^(10\.\d{4,9}/[^()\[\]\s<>&?\"']+)", re.I)
DOI_QS_RE       = re.compile(r"[?&]doi=(10\.\d{4,9}/[^&\s<>'\"]+)", re.I)
SHORT_DOI_RE    = re.compile(r"https?://(?:dx\.)?doi\.org/10/[A-Za-z0-9]+", re.I)

def clamp_doi(s: str):
    s = re.sub(r"^\s*doi:\s*", "", s, flags=re.I).replace("\u00ad", "").replace("\u200b", "").strip()
    m = STRICT_DOI_CORE.match(s) or BARE_DOI_CORE.match(s)
    return ("https://doi.org/" + m.group(1)).lower() if m else None

def canonize(dois):
    out = set()
    for x in dois:
        c = clamp_doi(norm_doi(x))
        if c: out.add(c)
    return sorted(out)

